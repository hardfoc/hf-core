# Doxyfile — HF-Core Platform API Documentation
# =============================================================================
# Generates API reference for handlers, utilities, and integration layer.
# Uses doxygen-awesome-css theme for modern, dark-mode HTML output.
# =============================================================================

# --- Project ---
PROJECT_NAME           = "HardFOC Core"
PROJECT_BRIEF          = "API reference"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = build/doxygen

# --- Input ---
INPUT                  = handlers tests/host/mocks docs/_doxygen/mainpage.md
FILE_PATTERNS          = *.c *.cpp *.h *.hpp
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/_doxygen/mainpage.md
FILTER_PATTERNS        =

EXCLUDE                = *build* *cmake-build-* *managed_components* \
                         *__pycache__* *.pyc

EXCLUDE_PATTERNS       = */build/* */cmake-build-*/* */.git/* \
                         */managed_components/* */__pycache__/*

# --- Extraction ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
FULL_PATH_NAMES        = NO

# --- Build ---
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = YES
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES

# --- Warnings ---
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# --- HTML ---
GENERATE_HTML          = YES
PAGE_OUTLINE_PANEL     = NO
SEARCHENGINE           = YES

# --- Diagrams (Graphviz) ---
HAVE_DOT               = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES

# --- Disabled outputs ---
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# --- Cross-tree tags (optional; TAGFILES stays empty until the file exists) ---
# Tag file for optional cross-tree linking. Do not set TAGFILES until the
# referenced .tag exists (doxygen errors on a missing file). Typical order:
#   1) each hf-*-driver  2) hf-core  3) pw-hal  4) firmware apps / boot
# Keep TAGFILES empty here; GENERATE_TAGFILE writes a gitignored artifact.
TAGFILES               =

CASE_SENSE_NAMES       = NO

HTML_OUTPUT            = html
