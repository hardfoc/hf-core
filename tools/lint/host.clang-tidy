# clang-tidy gate for hf-core's own sources on the host compile database.
#
# Defect checks only (analyzer, bugprone, performance), not style: the style
# profile in _config/.clang-tidy stays advisory in ci-cpp-lint.yml. The
# analyzer needs real include paths and defines, so run this through
# tools/lint/run-clang-tidy.sh on a configured host-debug tree.
#
# Submodule headers are excluded by HeaderFilterRegex, and run-clang-tidy.sh
# drops analyzer reports located in them; their own CI covers them.
#
# bugprone-exception-escape is off: target builds compile without exceptions,
# so an allocation failure inside a noexcept function aborts either way.

Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-branch-clone,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(handlers|tests/host)/.*'
FormatStyle: none

CheckOptions:
  - key: bugprone-signed-char-misuse.CharTypdefsToIgnore
    value: 'int8_t'
