#include "@Chip@Handler.h"

#include <cstdint>

namespace hf {

@Chip@Handler::@Chip@Handler(@BusBase@& bus, HandlerMutex* bus_mutex) noexcept
    : HandlerBase(bus_mutex), comm_(bus) {}

@Chip@Handler::~@Chip@Handler() noexcept {
    DestroyDriver();  // the driver refers to comm_, which is destroyed before HandlerBase
}

Result<void> @Chip@Handler::InitializeLocked() noexcept {
    if (!comm_.EnsureInitialized()) {
        return Fail(Status::DependencyNotReady, static_cast<std::uint32_t>(comm_.LastBusError()));
    }
    // TODO(handler): apply the configuration once the chip has answered.
    return ToResult(EmplaceDriver(comm_).@InitMethod@());
}

}  // namespace hf
