/**
 * @file test_@chip_flat@.cpp
 * @brief `hf::@Chip@Handler` over `hf::host::@MockBus@`.
 *
 * The cases below hold for every standard handler (standards/handler.md, "Tests"). Add the chip's
 * own after them: script the mock like the chip (register model, canned replies), then check every
 * typed method, that a bus failure maps to `Status::Bus`, and the diagnostics counters.
 *
 * Generated by tools/new_handler.py from templates/handler/.
 */

#include "@Chip@Handler.h"
#include "HfCoreMocks.h"
#include "HostTest.h"

using hf::Status;

HF_TEST(test_@chip_flat@_constructor_does_no_io) {
  hf::host::@MockBus@ bus;
  hf::@Chip@Handler handler(bus);
  CHECK(!bus.IsInitialized());
  CHECK(!handler.IsInitialized());
  const auto d = handler.GetDiagnostics();
  CHECK_EQ(d.header.ok_count + d.header.error_count, 0U);
}

HF_TEST(test_@chip_flat@_init_retries_after_failure) {
  hf::host::@MockBus@ bus;
  bus.SetInitializeResult(false);
  hf::@Chip@Handler handler(bus);
  CHECK_EQ(handler.EnsureInitialized().status, Status::DependencyNotReady);
  CHECK(!handler.IsInitialized());
  CHECK_EQ(handler.EnsureInitialized().status, Status::DependencyNotReady); // tried again
  const auto d = handler.GetDiagnostics();
  CHECK(!d.header.initialized);
  CHECK_EQ(d.header.error_count, 2U);
  CHECK_EQ(d.header.last_error, Status::DependencyNotReady);
}

HF_TEST(test_@chip_flat@_visit_driver_refuses_before_init) {
  hf::host::@MockBus@ bus;
  hf::@Chip@Handler handler(bus);
  bool called = false;
  const Status s = handler.VisitDriver([&](auto& /*driver*/) {
    called = true;
    return Status::Ok;
  });
  CHECK_EQ(s, Status::NotInitialized);
  CHECK(!called);
  CHECK(!bus.IsInitialized());
}

HF_TEST(test_@chip_flat@_deinitialize_before_init_is_harmless) {
  hf::host::@MockBus@ bus;
  hf::@Chip@Handler handler(bus);
  CHECK(handler.Deinitialize().ok());
  CHECK(!handler.IsInitialized());
}

HF_TEST(test_@chip_flat@_only_the_driver_success_code_maps_to_ok) {
  using E = @driver_ns@::@ErrorEnum@;
  // clang-format off
  constexpr E kAll[] = {
@error_values@
  };
  // clang-format on
  for (const E e : kAll) {
    CHECK_EQ(hf::ToStatus(e) == Status::Ok, e == E::@ErrorOk@);
  }
}
