/**
 * @file test_@chip_flat@.cpp
 * @brief `hf::@Chip@Handler` over `hf::host::@MockBus@`.
 *
 * The cases below hold for every standard handler. Add the chip's own behaviour after them: script the
 * mock like the chip (register model, canned replies) and check the typed API, the error mapping and
 * the diagnostics.
 *
 * Generated by tools/new_handler.py from templates/handler/.
 */

#include "@Chip@Handler.h"
#include "HfCoreMocks.h"
#include "HostTest.h"

using hf::Status;

HF_TEST(@Chip@_ConstructorTouchesNoHardware) {
    hf::host::@MockBus@ bus;
    hf::@Chip@Handler handler(bus);
    CHECK(!bus.IsInitialized());
    CHECK(!handler.IsInitialized());
    CHECK_EQ(handler.GetDiagnostics().init_attempts, 0U);
}

HF_TEST(@Chip@_BusDownFailsInitAndCachesNothing) {
    hf::host::@MockBus@ bus;
    bus.SetInitializeResult(false);
    hf::@Chip@Handler handler(bus);
    CHECK_EQ(handler.EnsureInitialized().status(), Status::DependencyNotReady);
    CHECK(!handler.IsInitialized());
    // VisitDriver() retries the initialisation and reports the same failure.
    CHECK_EQ(handler.VisitDriver([](auto& /*driver*/) { return 0; }).status(), Status::DependencyNotReady);
    const auto d = handler.GetDiagnostics();
    CHECK_EQ(d.init_attempts, 2U);
    CHECK_EQ(d.init_failures, 2U);
    CHECK_EQ(d.last_status, Status::DependencyNotReady);
}

HF_TEST(@Chip@_DeinitializeBeforeInitIsHarmless) {
    hf::host::@MockBus@ bus;
    hf::@Chip@Handler handler(bus);
    CHECK(handler.Deinitialize().ok());
    CHECK(!handler.IsInitialized());
}

HF_TEST(@Chip@_OnlyTheDriverSuccessCodeMapsToOk) {
    using E = @driver_ns@::@ErrorEnum@;
    for (const E e : {@error_values@}) {
        CHECK_EQ(hf::ToStatus(e) == Status::Ok, e == E::@ErrorOk@);
    }
}
