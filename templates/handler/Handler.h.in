/**
 * @file @Chip@Handler.h
 * @brief Handler for the @Chip@ on a `@BusBase@` (driver: @driver_repo@).
 *
 * The standard handler (standards/handler.md, docs/handler-model.md): the constructor touches no
 * hardware; `EnsureInitialized()` builds the driver in place and runs its `@InitMethod@()`;
 * `VisitDriver()` is the only way to reach the driver. Every typed method returns an `hf::Result`;
 * driver errors are mapped once, in `Hal@Bus@@Chip@Comm.h`.
 *
 * Generated by tools/new_handler.py from templates/handler/.
 */
#pragma once

#include <cstdint>

#include "Hal@Bus@@Chip@Comm.h"
#include "HandlerBase.h"

namespace hf {

/// Construction-time settings of a @Chip@Handler (bus address, the driver's `Config`).
struct @Chip@HandlerConfig {};

/// What `@Chip@Handler::GetDiagnostics()` returns: the common header, then chip counters.
struct @Chip@Diagnostics {
  DiagnosticsHeader header; ///< Always first.
};

/// The driver a @Chip@Handler owns, in place.
using @Chip@Driver = @driver_ns@::@DriverClass@<Hal@Bus@@Chip@Comm>;

/**
 * @brief Thread-safe handler for one @Chip@.
 *
 * From `hf::HandlerBase`: `EnsureInitialized()`, `Deinitialize()`, `IsInitialized()` and
 * `VisitDriver()`. Typed methods go below, one per operation a HAL needs, each a `CallDriver()`:
 *
 * @code
 * Result<float> ReadPressurePa() noexcept {
 *   return CallDriver([](Driver& d) { return ToResult(d.ReadPressurePa()); });
 * }
 * @endcode
 */
class @Chip@Handler : public HandlerBase<@Chip@Handler, @Chip@Driver> {
public:
  /**
   * @param bus       The `@BusBase@` the chip is on. It must outlive the handler.
   * @param config    Construction-time settings.
   * @param bus_mutex Mutex shared by every handler on the same bus, or null.
   */
  explicit @Chip@Handler(@BusBase@& bus, const @Chip@HandlerConfig& config = {},
                         HandlerMutex* bus_mutex = nullptr) noexcept;
  ~@Chip@Handler() noexcept;

  @Chip@Handler(const @Chip@Handler&) = delete;
  @Chip@Handler& operator=(const @Chip@Handler&) = delete;
  @Chip@Handler(@Chip@Handler&&) = delete;
  @Chip@Handler& operator=(@Chip@Handler&&) = delete;

  /// The diagnostics header and the chip counters (no I/O).
  [[nodiscard]] @Chip@Diagnostics GetDiagnostics() const noexcept;

private:
  friend HandlerBase;

  /// Locks held, no driver yet: bring the bus up, build the driver, probe the chip.
  Result<void> initializeLocked() noexcept;

  Hal@Bus@@Chip@Comm comm_;
  @Chip@HandlerConfig config_;
};

} // namespace hf
