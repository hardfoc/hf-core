#pragma once

#include "Hal@Bus@@Chip@Comm.h"
#include "HandlerBase.h"

namespace hf {

/**
 * @brief Thread-safe handler for one @Chip@.
 *
 * Inherited from `hf::HandlerBase`: `EnsureInitialized()`, `IsInitialized()`, `Deinitialize()`,
 * `VisitDriver()` and `GetDiagnostics()`.
 */
class @Chip@Handler : public HandlerBase<@Chip@Handler, @driver_ns@::@DriverClass@<Hal@Bus@@Chip@Comm>> {
public:
    /**
     * @param bus       The `@BusBase@` the chip is on. It must outlive the handler.
     * @param bus_mutex Mutex shared by every handler on the same bus, or null when the bus is not shared.
     */
    explicit @Chip@Handler(@BusBase@& bus, HandlerMutex* bus_mutex = nullptr) noexcept;
    ~@Chip@Handler() noexcept;

    @Chip@Handler(const @Chip@Handler&) = delete;
    @Chip@Handler& operator=(const @Chip@Handler&) = delete;
    @Chip@Handler(@Chip@Handler&&) = delete;
    @Chip@Handler& operator=(@Chip@Handler&&) = delete;

    // TODO(handler): the typed API a HAL needs, one method per operation, each a VisitDriver() call:
    //   Result<Sample> ReadSample() noexcept {
    //       return VisitDriver([](Driver& d) { return ToResult(d.ReadSample()); });
    //   }

private:
    friend HandlerBase;

    /// Locks held, no driver yet: bring the bus up, build the driver, probe the chip.
    Result<void> InitializeLocked() noexcept;

    Hal@Bus@@Chip@Comm comm_;
};

}  // namespace hf
