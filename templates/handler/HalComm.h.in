/**
 * @file Hal@Bus@@Chip@Comm.h
 * @brief The @Chip@ driver's port on a `@BusBase@`, and the one mapping of its errors.
 *
 * Every port hook comes from `hf::Hal@Bus@CommBase`. Add a hook here only when the driver needs one
 * the base does not have; for control pins chain `hf::HalGpioCommBase` (HalGpioCommBase.h).
 *
 * Generated by tools/new_handler.py from templates/handler/.
 */
#pragma once

#include <cstdint>

#include "@driver_header@"

#include "hf/iiw/Status.h"

#include "Hal@Bus@CommBase.h"

namespace hf {

class Hal@Bus@@Chip@Comm;

/// The driver's port base, instantiated for the adapter.
using @Chip@Port = @driver_ns@::@PortBase@<Hal@Bus@@Chip@Comm>;

/// `@driver_ns@::@PortBase@` on a `@BusBase@`.
class Hal@Bus@@Chip@Comm final : public Hal@Bus@CommBase<Hal@Bus@@Chip@Comm, @Chip@Port> {
public:
  using Hal@Bus@CommBase::Hal@Bus@CommBase;
};

/**
 * @brief `hf::Status` for a @Chip@ driver error (standards/errors.md, driver errors).
 *
 * Every enumerator is listed and there is no `default`, so a value the driver adds later is a
 * -Wswitch error here. Chip-specific values are documented on the handler's page.
 */
[[nodiscard]] constexpr Status ToStatus(@driver_ns@::@ErrorEnum@ error) noexcept {
  switch (error) {
@error_cases@
  }
  return Status::Unknown;
}

/// A driver result as an `hf::Result`, with the driver's error value as detail.
template <typename T>
[[nodiscard]] constexpr Result<T> ToResult(const @driver_ns@::@ResultType@<T>& r) noexcept {
  return {r.value, ToStatus(r.error), static_cast<uint16_t>(r.error)};
}

/// A driver result without a value as an `hf::Result<void>`.
[[nodiscard]] constexpr Result<void> ToResult(const @driver_ns@::@ResultType@<void>& r) noexcept {
  return {ToStatus(r.error), static_cast<uint16_t>(r.error)};
}

} // namespace hf
