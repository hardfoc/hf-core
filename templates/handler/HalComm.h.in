#pragma once

#include <cstdint>

#include "@driver_header@"
#include "Hal@Bus@Comm.h"
#include "HfResult.h"

namespace hf {

/// `@driver_ns@::@PortBase@` on a `@BusBase@`.
class Hal@Bus@@Chip@Comm final
    : public Hal@Bus@Comm<Hal@Bus@@Chip@Comm, @driver_ns@::@PortBase@<Hal@Bus@@Chip@Comm>> {
public:
    using Hal@Bus@Comm::Hal@Bus@Comm;
};

/**
 * @brief `hf::Status` for a @Chip@ driver error.
 *
 * Every enumerator is listed and there is no `default`, so an error the driver adds later is a
 * -Wswitch error here. The first draft came from tools/status_rules.py; review it against the driver.
 */
[[nodiscard]] constexpr Status ToStatus(@driver_ns@::@ErrorEnum@ error) noexcept {
    switch (error) {
@error_cases@
    }
    return Status::Unknown;
}

/// A driver result as an `hf::Result`; the driver's error value is the detail.
template <typename T>
[[nodiscard]] inline Result<T> ToResult(const @driver_ns@::@ResultType@<T>& result) noexcept {
    if (result.ok()) {
        return result.value;
    }
    return Fail(ToStatus(result.error), static_cast<std::uint32_t>(result.error));
}

/// A driver result without a value as an `hf::Result<void>`.
[[nodiscard]] inline Result<void> ToResult(const @driver_ns@::@ResultType@<void>& result) noexcept {
    if (result.ok()) {
        return {};
    }
    return Fail(ToStatus(result.error), static_cast<std::uint32_t>(result.error));
}

}  // namespace hf
